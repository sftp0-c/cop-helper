{
  "manifest_version": 3,
  "name": "ЦОП Помощник",
  "version": "1.0.0",
  "description": "Помощник по ЦОП: показывает последовательность действий и подсвечивает кнопки, куда нажать.",
  "browser_specific_settings": {
    "gecko": {
      "id": "cop-helper@admhmao.ru"
    }
  },
  "icons": {
    "96": "icon.svg"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "ЦОП Помощник",
    "default_icon": "icon.svg"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["data.js", "content.js"],
      "run_at": "document_idle"
    }
  ],
  "host_permissions": ["<all_urls>"]
}
